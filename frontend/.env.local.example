# Local development. Copy to .env.local and fill in.
#
# Every NEXT_PUBLIC_* value here is inlined into the browser bundle by `next build`,
# so none of it is secret — but all of it is frozen at build time. See
# src/lib/origins.ts for why that matters and what the fallbacks now are.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key — safe in the browser, RLS-backed>

# The Worker: API base and the origin that serves short codes. In production both
# are https://qrly.lol — the dashboard and the redirect engine share one hostname,
# so they are the same origin. Left unset, a *production* build now falls back to
# https://qrly.lol rather than to localhost; these two lines are what point a local
# dev server at the local Worker instead.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_REDIRECT_ORIGIN=http://localhost:8787

# Gates the custom-domain UI: when false, the domains screen says plainly that
# certificates cannot be issued instead of letting verification fail mysteriously.
# Set to true only where the Worker actually holds CLOUDFLARE_API_TOKEN and
# CLOUDFLARE_ZONE_ID.
NEXT_PUBLIC_CLOUDFLARE_CONFIGURED=false
